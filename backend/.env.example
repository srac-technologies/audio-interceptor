# ========================================
# Meeting Assistant 設定ファイル
# ========================================
#
# [パッケージ版の場合]
# このファイルは初回起動時に以下へコピーされます:
#   Linux:   ~/.config/meeting-assistant/config/.env
#   macOS:   ~/Library/Application Support/meeting-assistant/config/.env
#   Windows: %APPDATA%/meeting-assistant/config/.env
#
# ファイルパスは、この .env がある設定フォルダからの相対パスで指定できます。
# 例: GOOGLE_SERVICE_ACCOUNT_FILE=creds.json
#      → 設定フォルダ内の creds.json を参照します

# ========================================
# Whisper文字起こし設定
# ========================================

# モード選択: "local" (faster-whisper) または "api" (OpenAI API)
# local: CPU/GPUで動作、オフライン可、初回モデルダウンロードあり
# api: OpenAI API使用、高速、課金あり
WHISPER_MODE=local

# モデル選択
# local時: tiny, base, small, medium, large-v3 (smallが推奨)
# api時: whisper-1 (固定)
WHISPER_MODEL=small

# 言語指定: ja (日本語), en (英語), auto (自動検出)
# 言語を指定すると精度が向上します
WHISPER_LANGUAGE=ja

# ========================================
# OpenAI API設定 (WHISPER_MODE=api またはリサーチ機能で必要)
# ========================================

# APIキー取得: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# ========================================
# Google Calendar連携 (オプション)
# ========================================

# Service Account JSON ファイルパス
# Google Cloud Console > APIs & Services > Credentials からダウンロード
# サービスアカウントのメールアドレスにカレンダーの共有設定が必要です
#
# [パッケージ版] 設定フォルダに creds.json を配置し、ファイル名だけ指定:
#   GOOGLE_SERVICE_ACCOUNT_FILE=creds.json
#
# [開発版] 絶対パスでも相対パスでも指定可能:
#   GOOGLE_SERVICE_ACCOUNT_FILE=/home/user/keys/service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=creds.json
