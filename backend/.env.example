# ========================================
# Whisper文字起こし設定
# ========================================

# モード選択: "local" (faster-whisper) または "api" (OpenAI API)
# local: CPU/GPUで動作、オフライン可、初回モデルダウンロードあり
# api: OpenAI API使用、高速、課金あり
WHISPER_MODE=local

# モデル選択
# local時: tiny, base, small, medium, large-v3 (smallが推奨)
# api時: whisper-1 (固定)
WHISPER_MODEL=small

# 言語指定: ja (日本語), en (英語), auto (自動検出)
# 言語を指定すると精度が向上します
WHISPER_LANGUAGE=ja

# ========================================
# OpenAI API設定 (WHISPER_MODE=api の場合のみ必要)
# ========================================

# APIキー取得: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# ========================================
# Google Calendar連携 (オプション)
# ========================================

# Service Account JSON file path (for server-to-server auth)
# Download from Google Cloud Console: APIs & Services > Credentials
# Grant calendar access to the service account email
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-key.json
