{
  "name": "meeting-assistant",
  "productName": "Meeting Assistant",
  "version": "0.1.0",
  "description": "AI-powered meeting assistant with real-time transcription and advice",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder -mwl"
  },
  "keywords": [
    "electron",
    "meeting",
    "assistant",
    "transcription",
    "AI"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srac-technologies/audio-interceptor.git"
  },
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "active-win": "^8.2.0"
  },
  "build": {
    "appId": "com.meetingassistant.app",
    "productName": "Meeting Assistant",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "extraResources": [
        {
          "from": "../backend/dist/server",
          "to": "backend/server"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "../backend/dist/server",
          "to": "backend/server"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "../backend/dist/server.exe",
          "to": "backend/server.exe"
        }
      ]
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
