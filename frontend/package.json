{
  "name": "meeting-assistant",
  "productName": "Meeting Assistant",
  "version": "0.1.0",
  "description": "AI-powered meeting assistant with real-time transcription and advice",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder -mwl",
    "test": "jest --verbose"
  },
  "keywords": [
    "electron",
    "meeting",
    "assistant",
    "transcription",
    "AI"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "jest": "^30.3.0"
  },
  "dependencies": {
    "active-win": "^8.2.0"
  },
  "build": {
    "appId": "com.meetingassistant.app",
    "productName": "Meeting Assistant",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/server",
        "to": "backend/server"
      },
      {
        "from": "../backend/.env.example",
        "to": "backend/.env.example"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
